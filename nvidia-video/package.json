{
  "name": "nvidia-explainer-video",
  "version": "1.0.0",
  "private": true,
  "description": "60-second 1080x1920 NVIDIA investment explainer built with Remotion",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "preview:stills": "node scripts/stills.mjs",
    "render": "remotion render src/index.ts NvidiaExplainer out/nvidia-explainer.mp4 --codec h264 --crf 18",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.539",
    "@remotion/fonts": "^4.0.539",
    "@remotion/media-utils": "^4.0.539",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.539"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.539",
    "@remotion/renderer": "^4.0.539",
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
